# Database
DATABASE_URL="postgresql://itsm:itsm_dev_password@localhost:5432/itsm_db?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Auth / JWT
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="itsm-attachments"
S3_ACCESS_KEY="itsm_minio"
S3_SECRET_KEY="itsm_minio_password"
S3_REGION="us-east-1"

# App URLs
API_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
APP_PORT=3000
